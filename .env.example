# 应用设置
DEBUG=True
APP_ENV=development

# Docker 构建参数
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

AGENT_RECURSION_LIMIT=30

# 搜索引擎，支持的值：bright_data（推荐）、tavily、duckduckgo、brave_search、arxiv
SEARCH_API=bright_data
BRIGHT_DATA_API_KEY= #API key's can be fetched from your Account settings
BRIGHT_DATA_ZONE="<zone_name>" #This should be a Web Unlocker Zone
BRIGHT_DATA_DEFAULT_ENGINE="<search_engine>" # google(recommended), bing, yandex
# TAVILY_API_KEY=tvly-xxx
# BRAVE_SEARCH_API_KEY=xxx # 仅当 SEARCH_API 为 brave_search 时必填
# JINA_API_KEY=jina_xxx # 可选，默认为 None

# 可选，用于生成播客的火山引擎 TTS
VOLCENGINE_TTS_APPID=xxx
VOLCENGINE_TTS_ACCESS_TOKEN=xxx
# VOLCENGINE_TTS_CLUSTER=volcano_tts # 可选，默认为 volcano_tts
# VOLCENGINE_TTS_VOICE_TYPE=BV700_V2_streaming # 可选，默认为 BV700_V2_streaming

# 可选，用于 LangSmith 追踪和监控
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
# LANGSMITH_API_KEY="xxx"
# LANGSMITH_PROJECT="xxx"

# [!NOTE]
# 有关模型设置及其他配置，请参阅 `docs/configuration_guide.md`
